APP_NAME="Grizzly Cashflow"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

APP_LOCALE=pt_BR
APP_FALLBACK_LOCALE=pt_BR
APP_FAKER_LOCALE=pt_BR

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# Produção: hospedagem compartilhada MySQL/MariaDB (docs/02-modelo-de-dados.md).
# Local/CI sem servidor MySQL disponível: trocar para sqlite (ver comentário abaixo).
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=grizzlycashflow
DB_USERNAME=root
DB_PASSWORD=
# DB_CONNECTION=sqlite
# DB_DATABASE=/absolute/path/to/database.sqlite

# Sessão server-side (ADR-0009) — nunca stateless/JWT.
SESSION_DRIVER=database
SESSION_LIFETIME=43200
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null
SESSION_SECURE_COOKIE=true

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local

# Fila em MySQL drenada por cron (ADR-0002) — nunca Redis/SQS.
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="nao-responder@example.com"
MAIL_FROM_NAME="${APP_NAME}"

VITE_APP_NAME="${APP_NAME}"

# --- Grizzly Cashflow: IA (ADR-0003 — nuvem com PII redigida, reversível por flag) ---
AI_PROVIDER=claude
# AI_PROVIDER=null  -> desliga a IA inteira; sistema opera 100% com regras + estatística (opção C do ADR-0003)
ANTHROPIC_API_KEY=
AI_MODEL_CLASSIFY=claude-haiku-4-5
AI_MODEL_DOCUMENT=claude-sonnet-5
AI_MONTHLY_BUDGET_USD=5.00
AI_PII_REDACTION_ENABLED=true

# --- Grizzly Cashflow: 2FA (TOTP, ADR-0009) ---
TOTP_SECRET_ENCRYPTION_KEY=

# --- Grizzly Cashflow: backup (docs/11-seguranca.md) ---
BACKUP_ENCRYPTION_KEY=
BACKUP_OFFSITE_DRIVER=
